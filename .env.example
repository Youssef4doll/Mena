# Postgres (Neon/Supabase/Vercel Postgres). Pooled URL for the app.
DATABASE_URL="postgresql://user:password@host:5432/mena"
# Direct (unpooled) URL for migrations, if DATABASE_URL goes through a pooler.
DATABASE_URL_UNPOOLED=""
# 32+ random characters. Signs sessions and hashes tokens. Never share it.
APP_SECRET=""
# First back-office account, created by `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Public URL of the shop, no trailing slash. The ONE address Google indexes: canonical
# links, sitemap.xml, robots.txt and structured data all use it, and in production every
# other domain of the project redirects here. Must be the property verified in Search Console.
NEXT_PUBLIC_SITE_URL="https://menatn.vercel.app"
# Optional: secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# Optional: automatic translation to Tunisian Arabic in the back office (server only).
ANTHROPIC_API_KEY=
