# Postgres (Neon/Supabase/Vercel Postgres). Pooled URL for the app.
DATABASE_URL="postgresql://user:password@host:5432/mena"
# Direct (unpooled) URL for migrations, if DATABASE_URL goes through a pooler.
DATABASE_URL_UNPOOLED=""
# 32+ random characters. Signs sessions and hashes tokens. Never share it.
APP_SECRET=""
# First back-office account, created by `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Public URL of the shop, no trailing slash.
NEXT_PUBLIC_SITE_URL="https://mena.tn"
# Optional: secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""
